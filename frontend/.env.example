# TalentTrek Frontend Environment Variables
# Copy this file to .env and update the values as needed

# API Configuration
# Choose one of the following options:

# Option 1: Use deployed backend (recommended for most development)
VITE_API_BASE_URL=https://talenttrek-api.vercel.app

# Option 2: Use local backend (uncomment if running backend locally)
# VITE_API_BASE_URL=http://localhost:5000

# Application Environment
VITE_APP_ENV=development

# Debug mode (set to false in production)
VITE_DEBUG=true
